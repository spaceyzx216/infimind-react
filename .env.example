# Copy to .env.local and fill in the values.
LOCAL_SERVER_PORT=8789
# Task platform: auto uses BullMQ when REDIS_URL is present, otherwise the
# persistent SQLite queue is used for local development and tests.
TASK_QUEUE_MODE=auto
REDIS_URL=
TASK_RUN_WORKER=true
TASK_WORKER_CONCURRENCY=1
TASK_MAX_ATTEMPTS=3
TASK_RESULT_RETENTION_DAYS=30
TASK_FILE_RETENTION_HOURS=24
TASK_UPLOAD_ROOT=
# Keep true only for local platform tests; production should use a real model.
TASK_FAKE_LLM=false
# Required by the JWT access-token service. Use a random secret of at least 32 bytes;
# keep the actual value only in .env.local or the production environment.
JWT_SECRET=replace_with_a_random_32_byte_or_longer_secret
JWT_ISSUER=fafee-api
JWT_AUDIENCE=fafee-web
# Comma-separated browser origins allowed to write refresh-token cookies in production.
AUTH_ALLOWED_ORIGINS=
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# DeepSeek 官方模型名；用工咨询的快速/深度模式都从此配置读取。
DEEPSEEK_FLASH_MODEL=deepseek-flash

# Hybrid RAG infrastructure. The default models use SiliconFlow:
# BAAI/bge-m3 for embedding and BAAI/bge-reranker-v2-m3 for reranking.
# Start Qdrant with: docker compose -f docker-compose.rag.yml up -d
RAG_VECTOR_URL=http://127.0.0.1:6333
RAG_VECTOR_API_KEY=
RAG_VECTOR_COLLECTION=contract_knowledge_evidence
# Put the SiliconFlow key only in .env.local; never commit it.
SILICONFLOW_API_KEY=
RAG_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
# Leave blank to reuse SILICONFLOW_API_KEY.
RAG_EMBEDDING_API_KEY=
# 用工实务库随分支提供的向量使用该模型；改动后需重建 labor.db 向量索引。
RAG_EMBEDDING_MODEL=Pro/BAAI/bge-m3
# true rebuilds only the external Qdrant collection after each source import.
RAG_VECTOR_REBUILD_ON_IMPORT=false
# siliconflow (default) or heuristic. The former does not consume DeepSeek tokens.
RAG_RERANKER_MODE=siliconflow
RAG_RERANKER_URL=https://api.siliconflow.cn/v1/rerank
# Leave blank to reuse SILICONFLOW_API_KEY.
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 用工咨询可选覆盖项。留空时使用服务端默认值。
# LABOR_MAX_TOKENS=393216
# LABOR_QUERY_REWRITE=on
# LABOR_FOLLOWUP_QUERY_MAX_CHARS=20
# DEEPSEEK_CHAT_TIMEOUT_MS=60000
# DEEPSEEK_STREAM_TIMEOUT_MS=1800000
# RAG_EMBEDDING_TIMEOUT_MS=120000
# RAG_EMBEDDING_BATCH_SIZE=32
# RAG_EMBEDDING_MAX_RETRIES=3
# SILICONFLOW_TOTAL_TIMEOUT_MS=30000
# SILICONFLOW_MIN_ATTEMPT_MS=500

# 运维管理台（邀请码）：只在服务器 .env.local 配置；缺少任何必填项时管理台整体不启动（fail closed）。
# 用 node server/scripts/admin-init.js --username ops --credentials-out ~/.fafee-admin-credentials.txt 生成。
# 管理台只监听 127.0.0.1:ADMIN_PORT，绝不接入公开 8789/8790 应用或 nginx。
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_JWT_SECRET=
ADMIN_PORT=8791
# 可选覆盖项：
# ADMIN_SESSION_TTL_SECONDS=1800
# ADMIN_MAX_LOGIN_FAILURES=5
# ADMIN_LOGIN_WINDOW_SECONDS=600
# ADMIN_LOGIN_LOCK_SECONDS=900
# ADMIN_MAX_INVITES_PER_REQUEST=200
# ADMIN_MAX_INVITES_PER_DAY=1000
