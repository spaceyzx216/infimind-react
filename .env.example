# 复制为 .env.local 并填入真实值。.env.local 已被 Git 忽略，密钥永不入库。
LOCAL_SERVER_PORT=8789
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 官方模型名（API 的 /v1/models 只列 deepseek-flash 与 deepseek-v4-pro）。
# 曾写别名 deepseek-v4-flash：传了也返回 200，但响应里是 deepseek-flash，属未文档化行为。
DEEPSEEK_FLASH_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 混合检索基础设施
# ---------------------------------------------------------------------------
# ⚠️ RAG_EMBEDDING_MODEL 必须与 labor.db 内向量的 model 列一致，否则语义召回会
# 降级为纯词法（服务端会明确告警 model_mismatch）。改了它就必须重建索引：
#   npm run build:labor-embeddings
# 免费档 BAAI/bge-m3 共享队列会排队（实测 30 次请求出现 1 次 120s + 1 次 HTTP 500），
# 故生产使用 Pro 档。
RAG_EMBEDDING_MODEL=Pro/BAAI/bge-m3
RAG_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
# 留空表示复用 SILICONFLOW_API_KEY。
RAG_EMBEDDING_API_KEY=

# 重排器：免费档实测干净（25 次 max 0.72s、零错误），无需 Pro 档。
RAG_RERANKER_MODE=siliconflow
RAG_RERANKER_URL=https://api.siliconflow.cn/v1/rerank
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Qdrant 只服务「合同知识库」的向量路；未部署时会安全降级（探活失败即跳过），
# 不影响用工咨询——用工咨询的向量存在 labor.db 内，不依赖任何外部服务。
# 启动：docker compose -f docker-compose.rag.yml up -d
RAG_VECTOR_URL=http://127.0.0.1:6333
RAG_VECTOR_API_KEY=
RAG_VECTOR_COLLECTION=contract_knowledge_evidence
# true 表示每次素材导入后重建 Qdrant collection。
RAG_VECTOR_REBUILD_ON_IMPORT=false

# 密钥：只放 .env.local，永不提交。
SILICONFLOW_API_KEY=

# ---------------------------------------------------------------------------
# 以下均为可选覆盖项，不填则使用代码内默认值（此处列出以便需要时调整）
# ---------------------------------------------------------------------------
# 输出 token 上限。必须是 API 允许的最大值：思考(reasoning)与正文**共用**这个预算，
# 给少了会导致 max 档在思考阶段被 finish=length 截断、正文 0 字（实测必现）。
# 上限区间由 API 回包给出：valid range of max_tokens is [1, 393216]。
# LABOR_MAX_TOKENS=393216
# 追问检索词改写开关。关闭后退回"短提问并入上一轮"的启发式，
# 代价是长句纯指代追问（"那按照您刚才说的这个思路我们接下来具体应该怎么操作呢"）检索会跑偏。
# LABOR_QUERY_REWRITE=on
# 启发式回退路径的短提问阈值（字符）
# LABOR_FOLLOWUP_QUERY_MAX_CHARS=20
# DeepSeek 超时：非流式（改写等短任务）/ 流式（生成可合法跑数分钟）
# DEEPSEEK_CHAT_TIMEOUT_MS=60000
# DEEPSEEK_STREAM_TIMEOUT_MS=1800000
# 批量灌库的 embedding 预算（与检索热路径的 8s 分开）
# RAG_EMBEDDING_TIMEOUT_MS=120000
# RAG_EMBEDDING_BATCH_SIZE=32
# RAG_EMBEDDING_MAX_RETRIES=3
# SiliconFlow 一次逻辑请求的总预算（含全部重试）
# SILICONFLOW_TOTAL_TIMEOUT_MS=30000
# SILICONFLOW_MIN_ATTEMPT_MS=500
